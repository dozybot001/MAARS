# MAARS Configuration
# Copy to .env and fill in your API key, then run: bash start.sh (use Git Bash on Windows)

# --- OpenAI LLM ---
MAARS_OPENAI_API_KEY=
MAARS_OPENAI_MODEL=gpt-5.5
# Optional stage-specific overrides (fallback to MAARS_OPENAI_MODEL when unset)
MAARS_REFINE_MODEL=                              # unset → uses MAARS_OPENAI_MODEL
MAARS_RESEARCH_MODEL=                            # unset → uses MAARS_OPENAI_MODEL
MAARS_WRITE_MODEL=                               # unset → uses default model
MAARS_POLISH_MODEL=                              # unset → uses write model

# --- API ---
MAARS_API_CONCURRENCY=3                          # 1 = sequential, safest for 16 GB
MAARS_API_REQUEST_INTERVAL=0                     # min seconds between LLM calls; set 1-2 for free-tier rate limits
MAARS_OUTPUT_LANGUAGE=Chinese

# --- Research ---
MAARS_RESEARCH_MAX_ITERATIONS=3                  # 3 rounds keep runtime ~15-25 min

# --- Team (Refine / Write multi-agent rounds) ---
MAARS_TEAM_MAX_DELEGATIONS=5                     # 5 rounds; raise to 8 on beefier machines

# --- Kaggle ---
MAARS_KAGGLE_API_TOKEN=
MAARS_DATASET_DIR=data/

# --- Codex task executor ---
MAARS_CODEX_BIN=codex
MAARS_CODEX_MODEL=
MAARS_CODEX_REASONING_EFFORT=high                # low | medium | high | xhigh; unset to inherit Codex default
MAARS_CODEX_VERBOSITY=low                        # low | medium | high; unset to inherit Codex default
MAARS_CODEX_SANDBOX=workspace-write
MAARS_CODEX_TIMEOUT=
MAARS_CODEX_INHERIT_PROXY=true                   # pass HTTP(S)/ALL/NO_PROXY env vars into codex exec
MAARS_CODEX_SANDBOX_PROVIDER=local               # local | docker
MAARS_CODEX_DOCKER_IMAGE=                        # required when provider=docker; image must include Codex CLI
MAARS_CODEX_DOCKER_BIN=docker
MAARS_CODEX_DOCKER_CODEX_BIN=codex
MAARS_CODEX_DOCKER_GPUS=                         # set to all in a GPU Docker runtime
MAARS_AGENT_SESSION_TIMEOUT=4200                 # fallback timeout when Codex timeout is unset
